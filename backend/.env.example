# FastAPI Server Configurations
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="Enterprise SMS Campaign Management API"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# For local running outside docker, adjust HOST, USER, PASSWORD, DB, PORT accordingly
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bulk_sms_db
DATABASE_URL=postgresql+asyncpg://postgres:KhuYEEookXdbndFlaPdhLtPcIkjPLZIN@reseau.proxy.rlwy.net:13270/bulk_sms_db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Authentication & Security
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=9a3cf8d4b3c0be8d56b6279f0f971b4028bb46fe5d1b7a2d8e0e7a2c5a6b7e8d
JWT_REFRESH_SECRET_KEY=8f3c7a2d5e6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# SMS Gateway Configuration (Options: ESMS, SMSLENZ, NOTIFY, TWILIO, MOCK)
SMS_GATEWAY=ESMS

# Dialog eSMS Gateway Configuration (API v2 / v3)
ESMS_BASE_URL=https://e-sms.dialog.lk
ESMS_AUTH_URL=https://esms.dialog.lk
ESMS_USERNAME=your_esms_username
ESMS_PASSWORD=your_esms_password
ESMS_DEFAULT_MASK=UMG Lanka
ESMS_PAYMENT_METHOD=0
ESMS_DELIVERY_REPORT_URL=https://your-domain.com/api/v1/sms/delivery-report
ESMS_BATCH_SIZE=1000
ESMS_SEND_TPS_LIMIT=20
ESMS_API_TPS_LIMIT=30
ESMS_STATUS_CHECK_TPS_LIMIT=2

# SMSLenz Gateway Configuration
SMSLENZ_USER_ID=your_smslenz_user_id
SMSLENZ_API_KEY=your_smslenz_api_key
SMSLENZ_SENDER_ID=CAFECHAI
SMSLENZ_BASE_URL=https://smslenz.lk/api

# Notify.lk Gateway Configuration
NOTIFY_USER_ID=your_notify_user_id
